FROM arm64v8/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Cross-toolchain dla armv7 + biblioteki
RUN dpkg --add-architecture armhf && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        curl \
        ca-certificates \
        gcc-arm-linux-gnueabihf \
        libc6-dev-armhf-cross \
        libdrm-dev:armhf \
        libgbm-dev:armhf \
        libinput-dev:armhf \
        libudev-dev:armhf \
        libasound2-dev:armhf \
        libfontconfig1-dev:armhf \
        libssl-dev:armhf \
        libxkbcommon-dev:armhf \
        cmake \
        libwayland-server0:armhf \
        libwayland-client0:armhf \
        libwayland-cursor0:armhf \
        libegl1:armhf \
        libgles2:armhf \
        libegl-mesa0:armhf \
        libgl1-mesa-dri:armhf \
        libdrm2:armhf \
    && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Diagnostyka: lista zainstalowanych armhf bibliotek
RUN echo "=== armhf libs (wayland/egl/gbm) ===" && \
    ls -1 /usr/lib/arm-linux-gnueabihf/libwayland* \
          /usr/lib/arm-linux-gnueabihf/libEGL* \
          /usr/lib/arm-linux-gnueabihf/libGLES* \
          /usr/lib/arm-linux-gnueabihf/libgbm* \
          /usr/lib/arm-linux-gnueabihf/libdrm* 2>/dev/null && \
    echo "=== koniec ==="

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal

ENV PATH="/root/.cargo/bin:${PATH}"

RUN rustup toolchain install stable --profile minimal && \
    rustup target add armv7-unknown-linux-gnueabihf

ENV PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_PATH=/usr/lib/arm-linux-gnueabihf/pkgconfig \
    CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_LINKER=arm-linux-gnueabihf-gcc \
    CARGO_TARGET_ARMV7_UNKNOWN_LINUX_GNUEABIHF_RUNNER=/bin/true

WORKDIR /app
